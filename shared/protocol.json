{
  "archiveEntrySeparator": "::",
  "passwordErrorMarker": "7z-password",
  "archiveFormats": ["zip", "7z", "xlsx", "xls"],
  "events": {
    "externalWindowRequest": "external-window-request",
    "workspaceSearchBatch": "workspace-search-batch",
    "documentLoadProgress": "document-load-progress",
    "viewerUpdate": "viewer-update"
  },
  "imageFormats": [
    { "extensions": ["svg"], "mimeTypes": ["image/svg+xml"] },
    { "extensions": ["png"], "mimeTypes": ["image/png"] },
    { "extensions": ["jpeg", "jpg"], "canonicalExtension": "jpg", "mimeTypes": ["image/jpeg"] },
    { "extensions": ["gif"], "mimeTypes": ["image/gif"] },
    { "extensions": ["webp"], "mimeTypes": ["image/webp"] },
    { "extensions": ["bmp"], "mimeTypes": ["image/bmp"] },
    { "extensions": ["ico"], "mimeTypes": ["image/x-icon", "image/vnd.microsoft.icon"] },
    { "extensions": ["avif"], "mimeTypes": ["image/avif"] },
    { "extensions": ["apng"], "mimeTypes": ["image/apng"] }
  ],
  "encodingLabels": {
    "utf8": "UTF-8",
    "utf8bom": "UTF-8 (BOM)",
    "sjis": "Shift-JIS",
    "utf16le": "UTF-16LE"
  },
  "eolLabels": {
    "crlf": "CRLF",
    "lf": "LF"
  },
  "byteSize": {
    "base": 1024,
    "fractionDigits": 1,
    "units": ["B", "kB", "MB", "GB", "TB"]
  }
}
