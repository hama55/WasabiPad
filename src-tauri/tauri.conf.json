{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WasabiPad",
  "version": "1.8.1",
  "identifier": "app.wasabipad.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "WasabiPad",
        "width": 1100,
        "height": 750,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "media-src": "'self' customprotocol: asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "frame-src": "'self' asset: http://asset.localhost blob: file:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "worker-src": "'self'",
        "media-src": "'self' http://localhost:5173 asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "frame-src": "'self' asset: http://asset.localhost blob: file:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/wasabipad.ico"
    ]
  }
}
