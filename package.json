{
  "name": "wasabipad-ui",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "sync:ipc": "node scripts/sync-ipc.mjs",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "check:generated": "npm run sync:ipc && npm run sync:protocol && git diff --exit-code -- ui/generated core/src/protocol.rs",
    "sync:config": "node scripts/sync-app-config.mjs",
    "check:config": "node scripts/check-config.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "build": "npm test && npm run sync:config && npm run check:config && npm run sync:ipc && npm run check:ipc && tsc --noEmit && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2",
    "chart.js": "^4.5.1",
    "markdown-it": "^14.3.0",
    "papaparse": "^5.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@types/papaparse": "^5.5.2",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.10"
  }
}
